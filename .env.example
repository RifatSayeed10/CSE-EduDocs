# ==============================================================================
# CSE EduDocs - environment settings
# Copy to .env and fill in the values before running `docker compose up -d --build`.
# Never commit the real .env file.
# ==============================================================================

# Port on the NAS where the site will be reachable (http://<NAS-IP>:APP_PORT)
APP_PORT=3000

# --- Security (REQUIRED) -------------------------------------------------------
# Long random string used to sign login tokens. Generate one with:
#   openssl rand -hex 32
# If this changes, everyone has to log in again.
JWT_SECRET=CHANGE_ME_REPLACE_WITH_STRONG_RANDOM_SECRET

# --- First admin account -------------------------------------------------------
# Created automatically the first time the app starts with an empty database.
ADMIN_EMAIL=admin@cse.pust.ac.bd
# Leave empty to auto-generate a password; it is printed once in the app logs:
#   docker logs research_archive_app
ADMIN_DEFAULT_PASSWORD=
# Extra emails that always get the admin role (comma separated, optional)
ADMIN_EMAILS=

# Fill a brand-new database with sample papers/projects/faculty for testing.
# Keep false for the real department site.
SEED_DEMO_DATA=false

# --- MongoDB (REQUIRED) --------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=archive_admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
# Use mongo:4.4 if your NAS CPU has no AVX support (mongo container keeps restarting)
MONGO_IMAGE=mongo:7.0

# --- NAS folders (absolute paths on the NAS) -----------------------------------
# QNAP example: /share/Container/research-archive/app-data
NAS_APP_DATA_PATH=/share/Container/research-archive/app-data
NAS_MONGO_DATA_PATH=/share/Container/research-archive/mongo-data

# User/group the app runs as. The app-data folder must be writable by it.
# Default 1000:1000. Use 0:0 (root) only if you can't change folder ownership.
APP_UID=1000
APP_GID=1000

# --- Uploaded files -----------------------------------------------------------
# local = server disk (Docker/NAS/VPS). mongo = inside MongoDB (Render/hosts whose disk is wiped)
FILE_STORAGE=local
MAX_UPLOAD_MB=50

# --- Local development only (npm run dev, not used by Docker) -------------------
# MONGODB_URI=mongodb://127.0.0.1:27017/research_archive
# REQUIRE_MONGODB=false

# ==============================================================================
# Searching inside PDFs (text extraction + OCR for scanned PDFs)
# ==============================================================================
# false = never read text inside PDFs (search uses title/authors/keywords/abstract only)
PDF_TEXT_ENABLED=true
# Tesseract languages, joined with "+". ben = Bangla, eng = English.
# If almost everything is English, "eng" alone is faster and more accurate.
OCR_LANGS=ben+eng
# CPU threads per page. Keep it low (1-2) on a small NAS so the site stays fast.
OCR_THREADS=2
# Scan resolution for OCR. 300 is the best quality/speed balance.
OCR_DPI=300
# Very long PDFs: only the first N pages are read
OCR_MAX_PAGES=400

# ==============================================================================
# AI assistant (upload auto-fill + "Ask the archive")
# Leave all AI_PROVIDER_* empty to switch AI off.
# Any OpenAI-compatible API works. If provider 1 is rate-limited or down, 2 is used, then 3.
# Model names change often: copy a current model id from the provider's model list page.
#
#   Groq        URL=https://api.groq.com/openai/v1                        (free tier, key from console.groq.com)
#   Gemini      URL=https://generativelanguage.googleapis.com/v1beta/openai  (free tier, key from aistudio.google.com;
#                   free-tier prompts may be used by Google to improve its products)
#   OpenRouter  URL=https://openrouter.ai/api/v1                          (free models end with ":free")
#   Cerebras    URL=https://api.cerebras.ai/v1
#   Ollama      URL=http://<lab-pc-ip>:11434/v1   KEY=(empty)            (your own GPU PC, no limits)
# ==============================================================================
AI_PROVIDER_1_NAME=groq
AI_PROVIDER_1_URL=
AI_PROVIDER_1_KEY=
AI_PROVIDER_1_MODEL=

AI_PROVIDER_2_NAME=gemini
AI_PROVIDER_2_URL=
AI_PROVIDER_2_KEY=
AI_PROVIDER_2_MODEL=

AI_PROVIDER_3_NAME=
AI_PROVIDER_3_URL=
AI_PROVIDER_3_KEY=
AI_PROVIDER_3_MODEL=

# Protect the free limits: AI requests per normal user per day, and for the whole site.
# Admins/editors are only limited by the site-wide number.
AI_USER_DAILY_LIMIT=30
AI_GLOBAL_DAILY_LIMIT=800
# How much thesis text is sent with each question (characters). Lower it if a provider
# complains about request size / tokens per minute.
AI_CONTEXT_CHARS=9000
# Pages the upload assistant reads to fill the form
AI_METADATA_PAGES=6
# Let visitors use "Ask AI" without logging in (limited per IP address per day)
AI_ALLOW_GUESTS=true
AI_GUEST_DAILY_LIMIT=10
